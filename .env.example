# FieldDay uses the OpenAI-compatible SDK. For xAI Grok (recommended):
OPENAI_API_KEY=xai-...
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_MODEL=grok-4.3

# Other OpenAI-compatible providers work the same way — just change key/base/model.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
